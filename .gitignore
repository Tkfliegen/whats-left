# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local artwork drafts/duplicates; these three backgrounds are imported by CSS.
/pic/*
!/pic/whatleft-bk10.png
!/pic/whatleft-bk11.png
!/pic/whatleft-bk13.png

# Generated verification captures and historical scratch files stay local.
# Keep reports and the exact synthetic snapshots required by offline regressions.
/docs/*.json
/docs/evaluations/**
!/docs/evaluations/**/
!/docs/evaluations/**/*.md
!/docs/evaluations/leak-case-a-reliability/input.json
!/docs/evaluations/leak-lightning-ultra/cases.json
!/docs/evaluations/leak-ultra-hardened/cases.json
!/docs/evaluations/leak-ultra-switch/live-case-a.json
!/docs/evaluations/judge-style-final-combined/runs/J09.json
!/docs/evaluations/judge-style-final-combined/runs/J11.json
!/docs/evaluations/judge-style-full-pipeline/runs/J02.json
!/docs/evaluations/judge-style-full-pipeline/runs/J03.json
!/docs/evaluations/judge-style-full-pipeline/runs/J06.json
!/docs/evaluations/judge-style-full-pipeline/runs/J07.json
!/docs/evaluations/scenario-abstention-ownership/full/runs/J01.json
!/docs/evaluations/scenario-abstention-ownership/full/runs/J05.json

# Retain the final acceptance summary and reproducibility metadata.
!/docs/evaluations/judge-style-final-acceptance/cases.json
!/docs/evaluations/judge-style-final-acceptance/manifest.json
!/docs/evaluations/judge-style-final-acceptance/results.json
!/docs/evaluations/judge-style-final-acceptance/summary.json
!/docs/evaluations/judge-style-final-acceptance/source-check.json
!/docs/evaluations/judge-style-final-acceptance/verification.json
